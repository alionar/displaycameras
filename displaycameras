#!/bin/bash
### BEGIN INIT INFO
# Provides: displaycameras
# Required-Start: $network $local_fs xorg
# Required-Stop:
# Default-Start: 2 3 4 5
# Default-Stop: 0 1 6
# Short-Description: Displays RTSP camera feeds using mpv
### END INIT INFO

# Exit if not root
if [[ $EUID -ne 0 ]]; then
   echo "This script must be run as root"
   exit 0
fi

# Exit if mpv_ipccontrol is not executable and in PATH
if [ ! "$(which mpv_ipccontrol)" ]; then
    echo "mpv_ipccontrol must be executable and in the PATH env variable."
    exit 1
fi

# Exit if mpv is not installed
if [ ! "$(which mpv)" ]; then
    echo "Please install mpv: sudo apt install mpv"
    exit 1
fi

# Load global config
if [ -r /etc/displaycameras/displaycameras.conf ]; then
    . /etc/displaycameras/displaycameras.conf
else
    echo "/etc/displaycameras/displaycameras.conf does not exist or is not readable."
    exit 1
fi

# Load layout config (with optional display detection)
if [ "$displaydetect" = "true" ]; then
    if [ "$(grep disable_overscan /boot/config.txt | grep -v ^#)" = "disable_overscan=1" ]; then
        mode="$(fbset -s | grep ^mode | awk '{print $2}' | tr -d '"')"
        if [ -r /etc/displaycameras/layout.conf.$mode ]; then
            . /etc/displaycameras/layout.conf.$mode
            displaydetectactive=true
        else
            . /etc/displaycameras/layout.conf.default
        fi
    else
        . /etc/displaycameras/layout.conf.default
    fi
else
    . /etc/displaycameras/layout.conf.default
fi

# Ensure timeout has a value
[ "$omx_timeout" = "" ] && omx_timeout=30

PIDDIR=/var/run/displaycameras
PIDFILE=$PIDDIR/displaycameras.pid
DISPLAY_SEQUENCE_FILE=/tmp/displaycameras.seq
XDISPLAY="${DISPLAY:-:0}"
LOGDIR=/var/log/displaycameras
STATSDIR=$LOGDIR/stats
mkdir -p $PIDDIR $LOGDIR $STATSDIR

# Logging helper — writes to file and stdout
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$LOGDIR/displaycameras.log"; }

# Restart counter per camera
increment_restart() {
    local f="$STATSDIR/${1}.restarts"
    local count=0
    [ -f "$f" ] && count=$(cat "$f")
    echo $((count + 1)) > "$f"
}
get_restarts() {
    local f="$STATSDIR/${1}.restarts"
    [ -f "$f" ] && cat "$f" || echo 0
}

# Uptime tracker per camera
mark_start() { date '+%s' > "$STATSDIR/${1}.started"; }
get_uptime() {
    local f="$STATSDIR/${1}.started"
    if [ -f "$f" ]; then
        local started=$(cat "$f")
        local now=$(date '+%s')
        local secs=$((now - started))
        printf '%02dh:%02dm:%02ds' $((secs/3600)) $(((secs%3600)/60)) $((secs%60))
    else
        echo "unknown"
    fi
}

cameras="${#camera_names[@]}"
max_seq=$((cameras-1))

[ ! -f $DISPLAY_SEQUENCE_FILE ] && echo 0 > $DISPLAY_SEQUENCE_FILE
declare -i DISPLAY_SEQUENCE
DISPLAY_SEQUENCE=$(cat $DISPLAY_SEQUENCE_FILE)

# Convert omxplayer "x1 y1 x2 y2" → mpv "WxH+X+Y"
convert_geometry() {
    read x1 y1 x2 y2 <<< $1
    echo "$((x2-x1+1))x$((y2-y1+1))+${x1}+${y1}"
}

start_player() {
    local name="$1"
    local feed="$2"
    local pos="$3"
    local geo
    geo=$(convert_geometry "$pos")
    local pidf="$PIDDIR/mpv-${name}.pid"

    local mpvlog="$LOGDIR/mpv-${name}.log"
    mark_start "$name"
    log "Starting mpv for ${name} at ${geo} — log: $mpvlog"
    DISPLAY=$XDISPLAY mpv \
        --no-terminal \
        --no-border \
        --ontop \
        --geometry="$geo" \
        --title="$name" \
        --hwdec=auto-safe \
        --rtsp-transport=tcp \
        --demuxer-lavf-o=timeout=$((omx_timeout * 1000000)) \
        --input-ipc-server="/tmp/mpv-${name}.sock" \
        --loop-file=inf \
        --log-file="$mpvlog" \
        --msg-level=all=warn \
        ${video_rotate:+--video-rotate=$video_rotate} \
        ${mpv_extra_opts:+$mpv_extra_opts} \
        "$feed" >> "$mpvlog" 2>&1 &
    echo $! > "$pidf"
}

case "$1" in
start)
    if [ -f $PIDFILE ]; then
        echo "PID file exists! Stop or Restart this service instead."
        exit 1
    fi
    if [ "$blank" = "true" ]; then
        log "Blanking screen"
        fbi --noverbose -T 2 /usr/bin/black.png >/dev/null 2>&1 &
    fi
    [ "$displaydetectactive" = "true" ] && echo "Display detection active for $mode resolution."
    startupfailure=false
    feedfailure=false
    for i in ${!camera_names[*]}; do
        startupretry=0
        feedretry=0
        x=$((i + DISPLAY_SEQUENCE))
        [ "$x" -ge "${#camera_names[@]}" ] && x=$((x - ${#camera_names[@]}))
        start_player "${camera_names[$i]}" "${camera_feeds[$i]}" "${window_positions[$x]}"
        sleep $startsleep
        while [ "$(mpv_ipccontrol ${camera_names[$i]} getplaystatus)" != "Playing" ]; do
            sleep 1
            log "Waiting for ${camera_names[$i]} mpv startup $startupretry"
            if [ "$startupretry" -eq "$retry" ]; then break; fi
            startupretry=$((startupretry+1))
        done
        if [ "$(mpv_ipccontrol ${camera_names[$i]} getplaystatus)" = "Playing" ]; then
            sleep $feedsleep
            while [ "$(mpv_ipccontrol ${camera_names[$i]} getposition)" = "0s" ]; do
                sleep 1
                log "Waiting for ${camera_names[$i]} playback $feedretry"
                if [ "$feedretry" -eq "$retry" ]; then
                    mpv_ipccontrol ${camera_names[$i]} quit
                    feedfailure=true
                    break
                fi
                feedretry=$((feedretry+1))
            done
        else
            startupfailure=true
        fi
        if [ "$(mpv_ipccontrol ${camera_names[$i]} getplaystatus)" = "Playing" ] && \
           [ "$(mpv_ipccontrol ${camera_names[$i]} getposition)" != "0s" ]; then
            log "${camera_names[$i]} started"
        else
            log "${camera_names[$i]} failed playback"
        fi
    done
    touch $PIDFILE
    if [ "$startupfailure" = "true" ] || [ "$feedfailure" = "true" ]; then
        log "Running a repair on failed feeds."
        $0 repair startup
    fi
    log "Camera Display Started"
    if [ "$rotate" = "true" ]; then
        [ "$rotatedelay" = "" ] && rotatedelay=5
        log "Starting camera rotation"
        rotatedisplays $rotatedelay &
    fi
    ;;

stop)
    rm -f $PIDFILE
    rm -f $DISPLAY_SEQUENCE_FILE
    [ "$rotate" = "true" ] && pkill rotatedisplays
    for i in "${camera_names[@]}"; do
        mpv_ipccontrol $i quit
    done
    sleep 2
    [ "$blank" = "true" ] && pkill fbi
    killall mpv > /dev/null 2>&1
    log "Camera Display Stopped"
    exit 0
    ;;

restart)
    $0 stop
    sleep 1
    $0 start
    ;;

repair)
    if [ ! -f $PIDFILE ]; then exit 0; fi
    if [ "$(pgrep -c mpv)" -gt "$cameras" ]; then
        $0 restart
    fi
    for i in ${!camera_names[*]}; do
        if [ "$(mpv_ipccontrol ${camera_names[$i]} getplaystatus)" != "Playing" ] || \
           [ "$(mpv_ipccontrol ${camera_names[$i]} getposition)" = "0s" ]; then
            increment_restart "${camera_names[$i]}"
            log "Repairing ${camera_names[$i]} (restart #$(get_restarts ${camera_names[$i]}))"
            rm -f $PIDFILE
            pkill rotatedisplays 2>/dev/null
            mpv_ipccontrol ${camera_names[$i]} quit
            x=$((i + DISPLAY_SEQUENCE))
            [ "$x" -ge "${#camera_names[@]}" ] && x=$((x - ${#camera_names[@]}))
            start_player "${camera_names[$i]}" "${camera_feeds[$i]}" "${window_positions[$x]}"
            sleep $startsleep
            startupretry=0
            feedretry=0
            while [ "$(mpv_ipccontrol ${camera_names[$i]} getplaystatus)" != "Playing" ]; do
                sleep 1
                log "Waiting for ${camera_names[$i]} mpv startup $startupretry"
                if [ "$startupretry" -eq "$retry" ]; then break; fi
                startupretry=$((startupretry+1))
            done
            if [ "$(mpv_ipccontrol ${camera_names[$i]} getplaystatus)" = "Playing" ]; then
                sleep $feedsleep
                while [ "$(mpv_ipccontrol ${camera_names[$i]} getposition)" = "0s" ]; do
                    sleep 1
                    log "Waiting for ${camera_names[$i]} playback $feedretry"
                    if [ "$feedretry" -eq "$retry" ]; then
                        mpv_ipccontrol ${camera_names[$i]} quit
                        break
                    fi
                    feedretry=$((feedretry+1))
                done
            fi
            if [ "$(mpv_ipccontrol ${camera_names[$i]} getplaystatus)" = "Playing" ] && \
               [ "$(mpv_ipccontrol ${camera_names[$i]} getposition)" != "0s" ]; then
                echo "${camera_names[$i]} started"
            else
                echo "${camera_names[$i]} failed playback"
            fi
            touch $PIDFILE
            if [ "$rotate" = "true" ] && [ "$2" != "startup" ]; then
                [ "$rotatedelay" = "" ] && rotatedelay=5
                echo "Restarting camera rotation"
                rotatedisplays $rotatedelay &
            fi
        fi
    done
    ;;

status)
    for i in "${camera_names[@]}"; do
        status="$(mpv_ipccontrol $i getplaystatus 2>/dev/null)"
        if [[ "$status" != "Playing"* ]]; then
            echo "$i is NOT playing"
        else
            echo "$i is $status"
        fi
    done
    ;;

positions)
    for i in "${camera_names[@]}"; do
        position="$(mpv_ipccontrol $i getposition)"
        echo "$position $i"
    done
    ;;

observe)
    # Live status dashboard — refreshes every 5s
    watch -n5 "
        echo '=== displaycameras observe ==='
        echo \"  $(date '+%Y-%m-%d %H:%M:%S')\"
        echo ''
        printf '%-20s %-10s %-12s %-10s\n' 'CAMERA' 'STATUS' 'UPTIME' 'RESTARTS'
        printf '%-20s %-10s %-12s %-10s\n' '------' '------' '------' '--------'
        for cam in ${camera_names[@]}; do
            status=\$(mpv_ipccontrol \$cam getplaystatus 2>/dev/null)
            [ -z \"\$status\" ] && status='STOPPED'
            uptime=\$([ -f $STATSDIR/\${cam}.started ] && awk -v s=\$(cat $STATSDIR/\${cam}.started) -v n=\$(date +%s) 'BEGIN{d=n-s; printf \"%02dh:%02dm:%02ds\",d/3600,(d%3600)/60,d%60}' || echo 'N/A')
            restarts=\$([ -f $STATSDIR/\${cam}.restarts ] && cat $STATSDIR/\${cam}.restarts || echo 0)
            printf '%-20s %-10s %-12s %-10s\n' \"\$cam\" \"\$status\" \"\$uptime\" \"\$restarts\"
        done
        echo ''
        echo '--- Recent log ---'
        tail -5 $LOGDIR/displaycameras.log 2>/dev/null
    "
    ;;

debug)
    # Toggle mpv log verbosity for a specific camera
    # Usage: displaycameras debug <camera_name> [on|off]
    cam="$2"
    mode="${3:-on}"
    mpvlog="$LOGDIR/mpv-${cam}.log"
    if [ "$mode" = "on" ]; then
        log "DEBUG ON for $cam — verbose mpv logging to $mpvlog"
        # Send IPC command to increase log verbosity
        echo '{"command":["set_property","msg-level","all=debug"]}' | socat - /tmp/mpv-${cam}.sock 2>/dev/null
    else
        log "DEBUG OFF for $cam"
        echo '{"command":["set_property","msg-level","all=warn"]}' | socat - /tmp/mpv-${cam}.sock 2>/dev/null
    fi
    ;;

logs)
    # Show all log file locations and sizes
    echo "=== Log files ==="
    for f in $LOGDIR/displaycameras.log $LOGDIR/ipc.log $LOGDIR/mpv-*.log; do
        [ -f "$f" ] && printf '  %-45s %s\n' "$f" "$(wc -l < $f) lines"
    done
    echo ""
    echo "=== Restart counts ==="
    for f in $STATSDIR/*.restarts; do
        [ -f "$f" ] && printf '  %-20s %s restarts\n' "$(basename $f .restarts)" "$(cat $f)"
    done
    ;;

*)
    echo "Usage: /usr/bin/displaycameras {start|stop|restart|repair|status|positions|observe|debug|logs|rotate|rotaterev}"
    exit 1
    ;;
esac
